{
  "name": "contabilidade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "tunnel": "docker compose stop postgres && ssh -fNL 5433:localhost:5434 root@72.61.37.230 -o ExitOnForwardFailure=yes && echo '✔ Túnel DB ativo → localhost:5433' || echo '✘ Falha ao abrir túnel'",
    "predev": "docker compose up -d postgres redis minio minio_init",
    "dev": "cross-env NODE_ENV=development tsx watch server.ts",
    "dev:tunnel": "docker compose up -d redis minio minio_init && cross-env NODE_ENV=development tsx watch server.ts",
    "build": "next build",
    "start": "tsx server.ts",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
