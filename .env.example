# =============================================================================
# Sistema de Gestão Contábil — Variáveis de Ambiente
#
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha TODOS os valores marcados com <ALTERE_ISTO>
#   3. NUNCA versione o arquivo .env no git (.gitignore já o exclui)
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação Next.js
# -----------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000  # https://contabilidade.seudominio.com.br

# Segredo para assinar os JWTs de sessão (min. 64 caracteres aleatórios)
# Gere com: openssl rand -base64 64
JWT_SECRET=9Ng5J3kpmHtSLRUZfKaUolhXOPH4WehAsbZvCDjxnWZM7b8vC8DXHXt2hKOSXgR0na5df62u8gnoxQYeVgbQCg==
JWT_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# PostgreSQL 16
# -----------------------------------------------------------------------------
POSTGRES_HOST=72.61.37.230
POSTGRES_PORT=5432
POSTGRES_DB=contabilidade
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Hstg_7294_Psql_X8

# URL de conexão usada pelo Prisma (pooler PgBouncer em prod recomendado)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# -----------------------------------------------------------------------------
# Redis 7
# -----------------------------------------------------------------------------
REDIS_HOST=72.61.37.230
REDIS_PORT=6379
REDIS_PASSWORD=%40Apl19751202
# Memória máxima alocada ao Redis (ajuste conforme RAM do servidor)
REDIS_MAXMEMORY=256mb

# URL de conexão usada pelo BullMQ e connect-redis
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# -----------------------------------------------------------------------------
# MinIO (S3 Self-Hosted)
# -----------------------------------------------------------------------------
#MINIO_ENDPOINT=minio
#MINIO_API_PORT=9000
#MINIO_CONSOLE_PORT=9001
#MINIO_ROOT_USER=minioadmin
#MINIO_ROOT_PASSWORD=<ALTERE_ISTO>
#MINIO_BUCKET=documentos-contabeis
#MINIO_USE_SSL=false

# MinIO (Ambiente Dev)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="admin123"
MINIO_BUCKET="documentos-contabeis"

# -----------------------------------------------------------------------------
# Diretório de dados no host (volumes bind-mount)
# Exemplo para VPS: DATA_DIR=/opt/contabilidade/data
# -----------------------------------------------------------------------------
DATA_DIR=./.data

# -----------------------------------------------------------------------------
# Asaas (Gateway de Pagamentos)
# -----------------------------------------------------------------------------
# sandbox | production
ASAAS_ENV=sandbox
# Token de validação dos webhooks — configure o mesmo valor no painel Asaas de cada contador
ASAAS_WEBHOOK_TOKEN=seu_token_secreto_aqui
