# =============================================================================
# Sistema de Gestão Contábil — Variáveis de Ambiente
#
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha TODOS os valores marcados com <ALTERE_ISTO>
#   3. NUNCA versione o arquivo .env no git (.gitignore já o exclui)
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação Next.js
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4500
NEXT_PUBLIC_APP_URL=http://localhost:4500

# Segredo para assinar os JWTs de sessão (min. 64 caracteres aleatórios)
# Gere com: openssl rand -base64 64
JWT_SECRET=<ALTERE_ISTO>
JWT_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# PostgreSQL 16
# -----------------------------------------------------------------------------
POSTGRES_HOST=<ALTERE_ISTO>
POSTGRES_PORT=5432
POSTGRES_DB=contabilidade
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<ALTERE_ISTO>

# URL de conexão usada pelo Prisma
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# -----------------------------------------------------------------------------
# Redis 7
# -----------------------------------------------------------------------------
REDIS_HOST=<ALTERE_ISTO>
REDIS_PORT=6379
REDIS_PASSWORD=<ALTERE_ISTO>
REDIS_MAXMEMORY=256mb

REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# -----------------------------------------------------------------------------
# MinIO (Object Storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_API_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=<ALTERE_ISTO>
MINIO_ROOT_PASSWORD=<ALTERE_ISTO>
MINIO_BUCKET=documentos-contabeis

# Porta do console web do MinIO (somente Docker local)
MINIO_CONSOLE_PORT=9001

# Endpoint público do MinIO — domínio real que o browser acessa para downloads/uploads.
# O Nginx já faz proxy de /{MINIO_BUCKET}/ → http://minio:9000/ (ver nginx/nginx.conf).
# Em produção: coloque o domínio da aplicação (sem https:// e sem barra final).
# Em desenvolvimento local: deixe vazio — o sistema usa o cliente interno.
MINIO_PUBLIC_ENDPOINT=fiscohub.azura.dev.br
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_SSL=true

# -----------------------------------------------------------------------------
# Diretório de dados no host (volumes bind-mount)
# Exemplo para VPS: DATA_DIR=/opt/contabilidade/data
# -----------------------------------------------------------------------------
DATA_DIR=./.data

# -----------------------------------------------------------------------------
# E-mail (Resend)
#
# Para não cair em spam:
#   1. Acesse resend.com → Domains → Add Domain → adicione seudominio.com.br
#   2. Configure os registros SPF, DKIM e DMARC no DNS do domínio
#   3. Aguarde verificação e use um endereço desse domínio em FROM_EMAIL
# -----------------------------------------------------------------------------
RESEND_API_KEY=<ALTERE_ISTO>
FROM_EMAIL=noreply@seudominio.com.br
RESEND_FROM_EMAIL=noreply@seudominio.com.br   # alias — mesmo valor de FROM_EMAIL
RESEND_FROM_NAME=FiscoHub
ADMIN_EMAIL=admin@seudominio.com.br

# -----------------------------------------------------------------------------
# Asaas (Gateway de Pagamentos)
# -----------------------------------------------------------------------------
# sandbox | production
ASAAS_ENV=sandbox
# Token de validação dos webhooks — configure o mesmo valor no painel Asaas
ASAAS_WEBHOOK_TOKEN=<ALTERE_ISTO>

# -----------------------------------------------------------------------------
# Banco Cora (Boletos)
# Token de validação dos webhooks — configure o mesmo valor no portal Cora
# -----------------------------------------------------------------------------
CORA_WEBHOOK_TOKEN=<ALTERE_ISTO>

# -----------------------------------------------------------------------------
# Modo Manutenção
# Quando 'true', bloqueia acesso de não-admins e redireciona para /manutencao
# -----------------------------------------------------------------------------
MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# ZapSign (Assinatura Eletrônica)
#
# Setup:
#   1. Crie conta em https://app.zapsign.com.br (use sandbox em dev)
#   2. Copie o API Token do painel ZapSign para ZAPSIGN_API_TOKEN
#   3. Configure webhook em ZapSign → URL: {NEXT_PUBLIC_APP_URL}/api/v1/webhooks/zapsign
#      Adicione header customizado: X-Zapsign-Webhook-Secret = <valor abaixo>
#   4. Defina ZAPSIGN_WEBHOOK_SECRET com o valor do header customizado
#
# Sandbox: https://sandbox.app.zapsign.com.br (evita cobrança em dev/staging)
# Sem ZAPSIGN_API_TOKEN, o sistema usa o fluxo interno de assinatura.
# -----------------------------------------------------------------------------
ZAPSIGN_API_TOKEN=
ZAPSIGN_WEBHOOK_SECRET=
