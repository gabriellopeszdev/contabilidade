// =============================================================================
// Prisma Schema — Sistema de Gestão Contábil
// Provider: PostgreSQL 16
//
// Convenções:
//   - PKs: UUIDv4 (gerado pelo Postgres via gen_random_uuid())
//   - Soft Delete: deletedAt (presente em entidades mutáveis; AuditLog é append-only)
//   - Tabelas em snake_case, modelos Prisma em PascalCase
//   - Todos os campos com nomes em camelCase no Prisma → snake_case no banco via @map
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums — espelham os tipos literais do domínio TypeScript
// =============================================================================

enum SetorTipo {
  FISCAL
  PESSOAL
  CONTABIL
  TODOS
}

enum VinculoTipo {
  ESCRITORIO
  CLIENTE
}

enum FileType {
  XML
  PDF
}

enum EstadoTarefa {
  PENDING
  PROCESSING
  REVIEW
  DONE
}

enum PrioridadeTarefa {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActionType {
  DOWNLOAD
  VIEW
  UPLOAD_BATCH
  LOGIN
  LOGOUT
  STATE_CHANGE
  OFFBOARD_INITIATED
  OFFBOARD_COMPLETED
  LGPD_EXPORT
  LGPD_ANONYMIZE
  CONSENT_ACCEPTED
  ACCOUNT_DELETED
  ESTORNO_SOLICITADO
  ASSINATURA_CANCELADA
}

enum ResourceType {
  DOCUMENT
  TASK
  USER
  SESSION
  OFFBOARDING
  BOLETO
  ASSINATURA
}

// =============================================================================
// UsuarioCliente
//
// Tabela separada de UsuarioContador (não STI) para:
//   - Constraint UNIQUE em CNPJ somente aqui
//   - Sem colunas NULL desnecessárias (CRC não se aplica ao cliente)
//   - Foreign keys explícitas por tipo de usuário
// =============================================================================

model UsuarioCliente {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  // CNPJ: 14 dígitos sem formatação (validação feita na entidade de domínio)
  cnpj         String    @unique @db.Char(14)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  isActive     Boolean   @default(true) @map("is_active")
  consentVersion    String?   @map("consent_version") @db.VarChar(20)
  consentAcceptedAt DateTime? @map("consent_accepted_at") @db.Timestamptz
  consentIpAddress  String?   @map("consent_ip_address") @db.Inet
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  // Relações
  documentos   DocumentoFiscal[]
  contadoresRel ContadorCliente[]
  chatRooms    ChatRoom[]
  funcionarios Funcionario[]  @relation("FuncionarioCliente")
  boletos      BoletoHonorario[]
  assinaturas  AssinaturaHonorario[]

  // Onboarding / Convite
  inviteToken     String?   @unique @map("invite_token") @db.VarChar(255)
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz
  activatedAt     DateTime? @map("activated_at") @db.Timestamptz
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?   @map("two_factor_secret") @db.VarChar(500)
  twoFactorBackupCodes String[]  @map("two_factor_backup_codes")

  // Índice parcial para ignorar registros soft-deleted em queries comuns.
  // OBS: índices parciais via Prisma requerem a cláusula `where` no schema.
  @@index([email])
  @@index([deletedAt])
  @@map("usuario_cliente")
}

// =============================================================================
// UsuarioContador
// =============================================================================

model UsuarioContador {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  // CRC: Registro no Conselho Regional de Contabilidade (ex: "CRC-SP-123456/O-1")
  crc          String    @unique @db.VarChar(30)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  isActive     Boolean   @default(true) @map("is_active")
  // true → usuário tem acesso ao painel Super Admin (/contadores e APIs /api/v1/admin/*)
  // Nunca expor este campo em respostas de API para roles CLIENT ou ACCOUNTANT
  isAdmin      Boolean   @default(false) @map("is_admin")
  consentVersion    String?   @map("consent_version") @db.VarChar(20)
  consentAcceptedAt DateTime? @map("consent_accepted_at") @db.Timestamptz
  consentIpAddress  String?   @map("consent_ip_address") @db.Inet
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  resetToken          String?   @unique @map("reset_token") @db.VarChar(255)
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?   @map("two_factor_secret") @db.VarChar(500)
  twoFactorBackupCodes String[]  @map("two_factor_backup_codes")

  // Relações
  clientesRel   ContadorCliente[]
  tarefasAssign TarefaKanban[]
  configuracao  ConfiguracaoEscritorio?
  obrigacoes    ObrigacaoFiscal[]
  funcionarios  Funcionario[] @relation("FuncionarioContador")
  boletosEmitidos BoletoHonorario[]
  assinaturas   AssinaturaHonorario[]

  @@index([email])
  @@index([deletedAt])
  @@map("usuario_contador")
}

// =============================================================================
// ContadorCliente — Tabela de junção N:N (Carteira de Clientes)
//
// Um contador pode gerenciar N clientes.
// Um cliente pode ter N contadores (ex: contador principal + substituto).
// =============================================================================

model ContadorCliente {
  contadorId String   @map("contador_id") @db.Uuid
  clienteId  String   @map("cliente_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  contador UsuarioContador @relation(fields: [contadorId], references: [id], onDelete: Cascade)
  cliente  UsuarioCliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@id([contadorId, clienteId])
  // Índice no lado inverso para carregar "todos os contadores de um cliente"
  @@index([clienteId])
  @@map("contador_cliente")
}

// =============================================================================
// Funcionario — Membro de equipe vinculado ao Escritório (ACCOUNTANT) ou
// à empresa Cliente (CLIENT).
//
// Um funcionário herda acesso restrito ao(s) setor(es) que lhe forem designados.
// Na query de documentos, se o usuário for EMPLOYEE, o WHERE obrigatoriamente
// inclui o filtro de setor — o funcionário NUNCA enxerga setores diferentes.
//
// superiorId aponta para o UsuarioContador (vínculo ESCRITORIO) ou
// UsuarioCliente (vínculo CLIENTE).
// =============================================================================

model Funcionario {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String      @db.VarChar(255)
  email        String      @unique @db.VarChar(255)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  phone        String?     @db.VarChar(20)
  avatarUrl    String?     @map("avatar_url") @db.VarChar(500)
  lastLoginAt  DateTime?   @map("last_login_at") @db.Timestamptz
  isActive     Boolean     @default(true) @map("is_active")

  // LGPD — consentimento
  consentVersion    String?   @map("consent_version") @db.VarChar(20)
  consentAcceptedAt DateTime? @map("consent_accepted_at") @db.Timestamptz
  consentIpAddress  String?   @map("consent_ip_address") @db.VarChar(45)

  // Tipo de vínculo: pertence ao escritório ou à empresa cliente
  vinculo      VinculoTipo

  // FK condicional — exatamente um dos dois é preenchido, nunca ambos:
  //   ESCRITORIO → contadorId preenchido, clienteId null
  //   CLIENTE    → clienteId preenchido, contadorId null
  contadorId   String?     @map("contador_id") @db.Uuid
  clienteId    String?     @map("cliente_id") @db.Uuid

  // Setores que o funcionário pode acessar (1 a N)
  setores      SetorTipo[]

  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz

  contador UsuarioContador? @relation("FuncionarioContador", fields: [contadorId], references: [id], onDelete: Cascade)
  cliente  UsuarioCliente?  @relation("FuncionarioCliente",  fields: [clienteId],  references: [id], onDelete: Cascade)

  @@index([contadorId])
  @@index([clienteId])
  @@index([email])
  @@index([deletedAt])
  @@map("funcionario")
}

// =============================================================================
// DocumentoFiscal
//
// Metadados do arquivo fiscal; o binário reside no MinIO (storagePath).
// Soft Delete via deletedAt: a remoção física do MinIO é feita no offboarding.
// =============================================================================

model DocumentoFiscal {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  uploadedById  String    @map("uploaded_by_id") @db.Uuid
  sector        SetorTipo
  fileName      String    @map("file_name") @db.VarChar(500)
  storagePath   String    @map("storage_path") @db.VarChar(1000)
  fileType      FileType  @map("file_type")
  // BigInt comporta arquivos de até ~9 PB; fiscal típico tem < 10 MB
  fileSizeBytes BigInt    @map("file_size_bytes")
  // SHA-256: exatamente 64 caracteres hexadecimais
  fileHash      String    @map("file_hash") @db.Char(64)
  readStatus    Boolean   @default(false) @map("read_status")
  readAt        DateTime? @map("read_at") @db.Timestamptz
  // Competência: apenas a data (ano/mês). Ex: 2026-01-01 representa Jan/2026.
  competencia   DateTime? @db.Date
  metadataJson  Json      @default("{}") @map("metadata_json")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  cliente UsuarioCliente @relation(fields: [clientId], references: [id])
  tarefas TarefaKanban[]
  chatMessages ChatMessage[]

  // ------------------------------------------------------------------
  // Índices — projetados para as queries do IDocumentoRepository
  //
  // 1. (clientId, sector)     → listarPorCliente com filtro de setor
  // 2. (clientId, fileType)   → filtro por tipo XML/PDF
  // 3. (clientId, readStatus) → filtro documentos lidos/não lidos
  // 4. (clientId, competencia)→ filtro por período de competência fiscal
  // 5. (fileHash, clientId)   → hashJaExiste(): deduplicação no upload
  // 6. (deletedAt)            → acelera WHERE deleted_at IS NULL
  // ------------------------------------------------------------------
  @@index([clientId, sector])
  @@index([clientId, fileType])
  @@index([clientId, readStatus])
  @@index([clientId, competencia])
  @@index([fileHash, clientId])
  @@index([deletedAt])
  @@map("documento_fiscal")
}

// =============================================================================
// TarefaKanban
//
// Card do quadro Kanban do escritório.
// Sem soft delete: tarefas são arquivadas pelo estado DONE.
// =============================================================================

model TarefaKanban {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String           @map("client_id") @db.Uuid
  assignedTo   String?          @map("assigned_to") @db.Uuid
  // Referência opcional ao documento que originou a tarefa (upload do cliente)
  documentId   String?          @map("document_id") @db.Uuid
  // Setor do documento — permite filtrar/exibir no Kanban por área
  sector       SetorTipo?
  title        String           @db.VarChar(255)
  description  String?          @db.Text
  currentState EstadoTarefa     @default(PENDING) @map("current_state")
  priority     PrioridadeTarefa @default(MEDIUM)
  dueDate      DateTime?        @map("due_date") @db.Date
  completedAt  DateTime?        @map("completed_at") @db.Timestamptz
  // Posição do card na coluna (drag-and-drop). Reordenação gerenciada no use case.
  position     Int              @default(0)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  contador  UsuarioContador? @relation(fields: [assignedTo], references: [id])
  documento DocumentoFiscal? @relation(fields: [documentId], references: [id])

  // (clientId, currentState) → carregamento de coluna no Kanban
  // (clientId, priority)     → ordenação por urgência
  @@index([clientId, currentState])
  @@index([clientId, priority])
  @@index([assignedTo])
  @@index([documentId])
  @@map("tarefa_kanban")
}

// =============================================================================
// AuditLog — Append-Only (nunca UPDATE, nunca DELETE)
//
// Registra toda ação sensível do sistema para fins de segurança e LGPD.
//
// PERFORMANCE EM PRODUÇÃO:
//   Esta tabela crescerá indefinidamente. Após a primeira migração, execute:
//
//   ALTER TABLE audit_log PARTITION BY RANGE (timestamp);
//   CREATE TABLE audit_log_2026_01 PARTITION OF audit_log
//     FOR VALUES FROM ('2026-01-01') TO ('2026-02-01');
//   -- (criar partição mensal via cron ou ferramenta como pg_partman)
//
// O Prisma não gerencia particionamento nativo; execute via migration raw SQL.
// =============================================================================

model AuditLog {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId   String?      @map("document_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  actionType   ActionType   @map("action_type")
  resourceType ResourceType @map("resource_type")
  // Nunca inclua senhas, tokens, CPF/CNPJ em detailsJson (LGPD Art. 46)
  detailsJson  Json         @default("{}") @map("details_json")
  // Tipo INET do PostgreSQL: suporta IPv4 e IPv6 com validação nativa
  ipAddress    String       @map("ip_address") @db.Inet
  userAgent    String?      @map("user_agent") @db.VarChar(500)
  timestamp    DateTime     @default(now()) @db.Timestamptz

  // (userId, timestamp)     → histórico de ações de um usuário
  // (documentId, timestamp) → linha do tempo de um documento
  // (actionType, timestamp) → relatórios de auditoria por tipo de ação
  // (timestamp)             → varredura temporal geral
  @@index([userId, timestamp])
  @@index([documentId, timestamp])
  @@index([actionType, timestamp])
  @@index([timestamp])
  @@map("audit_log")
}

// =============================================================================
// Chat Interno — Comunicação em Tempo Real (Contador ↔ Cliente)
// =============================================================================

enum SenderType {
  CONTADOR
  CLIENTE
}

enum MemberType {
  CONTADOR
  FUNCIONARIO
}

model ChatRoom {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId  String     @map("cliente_id") @db.Uuid
  memberId   String     @map("member_id") @db.Uuid
  memberType MemberType @map("member_type")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  cliente  UsuarioCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([clienteId, memberId])
  @@index([clienteId])
  @@index([memberId])
  @@map("chat_room")
}

model ChatMessage {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId     String     @map("room_id") @db.Uuid
  senderId   String     @map("sender_id") @db.Uuid
  senderType SenderType @map("sender_type")
  content    String     @db.Text
  documentId String?    @map("document_id") @db.Uuid
  readAt     DateTime?  @map("read_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  room     ChatRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  document DocumentoFiscal? @relation(fields: [documentId], references: [id])

  @@index([roomId, createdAt])
  @@index([roomId, readAt])
  @@index([senderId])
  @@map("chat_message")
}

// =============================================================================
// ConfiguracaoEscritorio — White Label & Personalização Visual
//
// Armazena a identidade visual do escritório (logo, cores, nome fantasia, CNPJ).
// Relação 1:1 com UsuarioContador (o admin do escritório). Se múltiplos
// contadores pertencem ao mesmo escritório, todos referenciam o mesmo registro.
//
// O logo é armazenado no MinIO (storagePath), não inline no banco.
// =============================================================================

model ConfiguracaoEscritorio {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contadorId     String  @unique @map("contador_id") @db.Uuid
  nomeEscritorio String  @map("nome_escritorio") @db.VarChar(255)
  cnpjEscritorio String? @map("cnpj_escritorio") @db.Char(14)
  logoUrl        String? @map("logo_url") @db.VarChar(1000)
  corPrimaria    String  @default("#2563eb") @map("cor_primaria") @db.VarChar(9)
  corSecundaria  String  @default("#1e3a8a") @map("cor_secundaria") @db.VarChar(9)
  // Integração Asaas
  asaasApiKey    String? @map("asaas_api_key") @db.VarChar(500)

  // Integração Cora — autenticação mTLS (OAuth 2.0 + certificado TLS)
  coraClientId       String? @map("cora_client_id")       @db.VarChar(200)
  coraCertificatePem String? @map("cora_certificate_pem") @db.Text
  coraPrivateKeyPem  String? @map("cora_private_key_pem") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contador UsuarioContador @relation(fields: [contadorId], references: [id], onDelete: Cascade)

  @@map("configuracao_escritorio")
}

// =============================================================================
// ObrigacaoFiscal — Calendário de Prazos de Obrigações Fiscais
//
// Armazena os prazos recorrentes (FGTS, DAS, ICMS, etc.) para o calendário.
// Cada obrigação pertence ao escritório (contadorId) e pode ser customizada.
// =============================================================================

model ObrigacaoFiscal {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contadorId  String    @map("contador_id") @db.Uuid
  nome        String    @db.VarChar(100)
  descricao   String?   @db.VarChar(500)
  diaVencimento Int     @map("dia_vencimento")
  cor         String    @default("#3b82f6") @db.VarChar(9)
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  contador UsuarioContador @relation(fields: [contadorId], references: [id], onDelete: Cascade)

  @@index([contadorId])
  @@map("obrigacao_fiscal")
}

// =============================================================================
// BoletoHonorario — Cobrança de Honorários do Escritório ao Cliente
//
// O PDF do boleto é armazenado no MinIO (storagePath).
// O contador (dono) gera e envia o boleto; o cliente visualiza e baixa.
// =============================================================================

enum StatusBoleto {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

enum TipoPagamento {
  BOLETO
  PIX
  INDEFINIDO
}

model BoletoHonorario {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId      String       @map("cliente_id") @db.Uuid
  escritorioId   String       @map("escritorio_id") @db.Uuid
  valor          Decimal      @db.Decimal(12, 2)
  vencimento     DateTime     @db.Date
  status         StatusBoleto @default(PENDENTE)
  mesReferencia  String       @map("mes_referencia") @db.VarChar(7) // "2026-04"
  // PDF local (MinIO) — preenchido apenas quando não há Asaas configurado
  storagePath    String?      @map("storage_path") @db.VarChar(1000)
  fileName       String?      @map("file_name") @db.VarChar(500)
  fileSizeBytes  BigInt?      @map("file_size_bytes")
  descricao      String?      @db.VarChar(500)
  // Campos Asaas — preenchidos quando emitido via Asaas
  asaasId             String? @map("asaas_id")              @db.VarChar(100)
  asaasBoletoUrl      String? @map("asaas_boleto_url")      @db.VarChar(500)
  asaasBarcode        String? @map("asaas_barcode")         @db.VarChar(200)
  asaasPixCopiaECola  String? @map("asaas_pix_copia_e_cola") @db.Text
  tipoPagamento       TipoPagamento @default(BOLETO)        @map("tipo_pagamento")
  asaasSubscriptionId String? @map("asaas_subscription_id") @db.VarChar(100)

  // Campos Cora — preenchidos quando emitido via Cora
  coraId         String? @map("cora_id")          @db.VarChar(100)
  coraBarcode    String? @map("cora_barcode")      @db.VarChar(300)
  coraBoletoUrl  String? @map("cora_boleto_url")   @db.VarChar(500)
  coraPixPayload String? @map("cora_pix_payload")  @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  cliente    UsuarioCliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  escritorio UsuarioContador @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@index([clienteId, status])
  @@index([clienteId, vencimento])
  @@index([escritorioId, mesReferencia])
  @@index([escritorioId, status])
  @@index([asaasId])
  @@index([coraId])
  @@map("boleto_honorario")
}

model AssinaturaHonorario {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId         String        @map("cliente_id") @db.Uuid
  escritorioId      String        @map("escritorio_id") @db.Uuid
  valor             Decimal       @db.Decimal(12, 2)
  ciclo             String        @db.VarChar(20)
  tipoPagamento     TipoPagamento @default(BOLETO) @map("tipo_pagamento")
  descricao         String?       @db.VarChar(500)
  asaasId           String?       @unique @map("asaas_id") @db.VarChar(100)
  asaasStatus       String?       @map("asaas_status") @db.VarChar(30)
  proximoVencimento DateTime?     @map("proximo_vencimento") @db.Date
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  cliente    UsuarioCliente  @relation(fields: [clienteId], references: [id])
  escritorio UsuarioContador @relation(fields: [escritorioId], references: [id])

  @@index([clienteId])
  @@index([escritorioId])
  @@index([asaasId])
  @@map("assinatura_honorario")
}

// =============================================================================
// WebhookEventLog — Idempotência de eventos Asaas
//
// eventKey = "{eventType}:{asaasPaymentId | asaasSubscriptionId}"
// O UNIQUE garante que eventos duplicados (retry do Asaas) não são reprocessados.
// =============================================================================

model WebhookEventLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventKey    String   @unique @map("event_key") @db.VarChar(200)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@map("webhook_event_log")
}

// =============================================================================
// Notificacao — Central de notificações in-app
//
// Persiste eventos relevantes para cada usuário (contador ou cliente).
// O campo userId pode referenciar tanto UsuarioContador quanto UsuarioCliente,
// sem FK para suportar os dois tipos sem complicar o schema.
// =============================================================================

model Notificacao {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  userType  String   @map("user_type") @db.VarChar(20)
  tipo      String   @map("tipo") @db.VarChar(50)
  titulo    String   @map("titulo") @db.VarChar(200)
  mensagem  String   @map("mensagem") @db.VarChar(500)
  lida      Boolean  @default(false) @map("lida")
  metadados Json?    @map("metadados")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, lida])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notificacao")
}
